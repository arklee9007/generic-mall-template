{
  "name": "generic-mall-template",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev:storefront": "npm run dev:h5 -w @generic-mall/storefront",
    "dev:admin": "npm run dev -w @generic-mall/admin",
    "build": "npm run build:h5 -w @generic-mall/storefront && npm run build:mp-weixin -w @generic-mall/storefront && npm run build -w @generic-mall/admin",
    "check": "npm run type-check --workspaces && node scripts/check-foundation.mjs",
    "build:release": "node scripts/build-release.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "lucide-static": "^0.468.0"
  }
}
